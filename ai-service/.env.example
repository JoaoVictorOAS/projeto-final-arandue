# Configurações do LLM Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
EMBEDDING_MODEL=intfloat/multilingual-e5-small

# Configurações de Vector Stores
VECTOR_PRIMARY=chroma          # dev: chroma | prod: firestore
VECTOR_FALLBACK=none           # dev: none   | prod: chroma
CHROMA_PATH=../data/chroma_db
CHROMA_COLLECTION=regras_mei_e5
FIRESTORE_PROJECT_ID=
FIRESTORE_COLLECTION=regras_mei_chunks
GOOGLE_APPLICATION_CREDENTIALS=
CORPUS_VERSION=

# Hiperparâmetros RAG
RAG_TOP_K=4
RAG_MAX_DISTANCE=0.135
RAG_MIN_SCORE=0.865
RAG_PRIMARY_TIMEOUT_S=1.5
RAG_BREAKER_FAILURES=3
RAG_BREAKER_RESET_S=60

# Segurança e Gateway
INTERNAL_SERVICE_SECRET=super_secreto_interno_arandue_2026
NODE_API_URL=http://localhost:3001/api

# Limites do Pool de MCP
MCP_POOL_MAX=50
MCP_IDLE_TTL_S=600

# Limites de Execução LLM
LLM_TIMEOUT_S=30
LLM_MAX_TOOL_CALLS=5
PORT=8001
