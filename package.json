{
  "name": "projeto-final-arandue",
  "version": "1.0.0",
  "description": "MEI — Gestão Simplificada para Microempreendedores Individuais (Recode Pro AI)",
  "private": true,
  "scripts": {
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:ai": "uvicorn app.main:app --app-dir ai-service --reload --port 8001",
    "test": "npm run test:backend && npm run test:frontend && npm run test:ai",
    "test:backend": "npm --prefix backend test",
    "test:frontend": "npm --prefix frontend test",
    "test:ai": ".venv/bin/pytest ai-service/tests",
    "build:frontend": "npm --prefix frontend run build",
    "db:seed": "node backend/src/database/seed.js",
    "rag:query": ".venv/bin/python scripts/rag/query_mei.py",
    "rag:recreate": "./scripts/rag/recreate_rag.sh",
    "graphify:query": ".venv/bin/graphify query",
    "graphify:update": ".venv/bin/graphify update"
  },
  "keywords": [
    "mei",
    "gestao",
    "react",
    "nodejs",
    "mysql",
    "recode-pro-ai"
  ],
  "author": "João Victor & Equipe Aranduê",
  "license": "ISC"
}
