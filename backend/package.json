{
  "name": "mei-backend",
  "version": "1.0.0",
  "description": "Backend API RESTful em Node.js e Express para o sistema MEI — Gestão Simplificada",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest --runInBand --forceExit",
    "db:migrate": "node src/database/migrate.js",
    "db:seed": "node src/database/seed.js",
    "whatsapp:reset": "rm -rf .wweb_auth_baileys && mkdir -p .wweb_auth_baileys"
  },
  "dependencies": {
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "mysql2": "^3.24.6",
    "pino": "^10.4.0",
    "qrcode-terminal": "^0.12.0"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "nodemon": "^3.1.14",
    "supertest": "^7.3.1"
  },
  "overrides": {
    "glob": "^13.0.6",
    "js-yaml": "^4.1.0",
    "chokidar": "^4.0.3"
  }
